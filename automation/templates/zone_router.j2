! ============================================================================
! {{ zone.router.hostname }} -- LAN side, zone {{ zone.label }}
!
! GENERATED FILE -- do not edit.
! Source: automation/inventory.yml -> render with automation/render.py
!
! Covers inter-VLAN routing and DHCP only. Transit-link addressing (stage A1)
! is configured separately and is not touched by this file.
! ============================================================================
enable
configure terminal
!
! --- Trunk to the access layer ----------------------------------------------
interface {{ zone.router.lan_interface }}
 description Trunk to {{ zone.switches[0].hostname }}
 no ip address
 no shutdown
exit
!
! --- Inter-VLAN routing (802.1Q sub-interfaces) -----------------------------
interface {{ zone.router.lan_interface }}.{{ zone.user_vlan.id }}
 description Users VLAN {{ zone.user_vlan.id }} -- {{ zone.label }}
 encapsulation dot1Q {{ zone.user_vlan.id }}
 ip address {{ zone.user_vlan.gateway }} {{ zone.user_vlan.mask }}
exit
!
interface {{ zone.router.lan_interface }}.{{ zone.mgmt_vlan.id }}
 description Management VLAN {{ zone.mgmt_vlan.id }} -- {{ zone.label }}
 encapsulation dot1Q {{ zone.mgmt_vlan.id }}
 ip address {{ zone.mgmt_vlan.gateway }} {{ zone.mgmt_vlan.mask }}
exit
!
! --- DHCP -------------------------------------------------------------------
ip dhcp excluded-address {{ dhcp_first_excluded }} {{ dhcp_last_excluded }}
!
ip dhcp pool {{ zone.router.dhcp_pool }}
 network {{ zone.user_vlan.subnet }} {{ zone.user_vlan.mask }}
 default-router {{ zone.user_vlan.gateway }}
 dns-server {{ defaults.dns_server }}
exit
!
end
!
copy running-config startup-config
