# ─────────────────────────────────────────────────────────────────────────────
# Copy to secrets.yml and fill in. secrets.yml is git-ignored.
#
#     cp automation/secrets.yml.example automation/secrets.yml
#
# Without it, render.py emits visible placeholders instead of credentials, so
# the repository and CI never carry a real password.
#
# On a production estate these values would come from a vault — Ansible Vault,
# HashiCorp Vault, SOPS — rather than a file on disk.
# ─────────────────────────────────────────────────────────────────────────────

enable_secret: change-me-enable

users:
  admin:
    privilege: 15
    password: change-me-admin
  operator:
    privilege: 5
    password: change-me-operator

wireless:
  SN1: change-me-wifi-1
  SN2: change-me-wifi-2
  SN3: change-me-wifi-3
